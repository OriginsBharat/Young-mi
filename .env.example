# This file is an example.
# Create a new file named .env (without .example) and add your configuration.

# -- Local AI Model --
# The name of the model you have downloaded in Ollama (e.g., "llama2", "mistral")
OLLAMA_MODEL="llama2"

# -- Valorant Username --
# Your exact in-game name (without the #tagline) for kill/death detection
PLAYER_USERNAME="YourValorantName"

# -- Cloud Memory (Pantry) --
# Get your free Pantry ID from https://getpantry.cloud/
PANTRY_ID="your-pantry-id-here"