# This file is an example.
# Run `first_run_setup.py` to generate your actual .env file.

# -- Local AI Model --
# The name of the model you have downloaded in Ollama (e.g., "llama3", "mistral")
OLLAMA_MODEL="llama3"

# -- Valorant Username --
# Your exact in-game name (without the #tagline) for kill/death detection
PLAYER_USERNAME="YourValorantName"

# -- Cloud Memory (Pantry) --
# Get your free Pantry ID from https://getpantry.cloud/
PANTRY_ID="your-pantry-id-here"

# -- Team Voice Chat (Optional) --
# This is set by running the setup wizard.
VIRTUAL_AUDIO_DEVICE_ID=""