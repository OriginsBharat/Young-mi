# This file is an example.
# Create a new file named .env (without .example) and add your API keys.
# This keeps your secret keys out of the main source code.

OPENAI_API_KEY="your_openai_api_key_here"
SERPAPI_API_KEY="your_serpapi_api_key_here" # Get a free key from https://serpapi.com/
# Get this from your Google Cloud project settings.
GCLOUD_PROJECT="your-gcp-project-id"
# Create a service account in your GCP project and download its JSON key.
GOOGLE_APPLICATION_CREDENTIALS="path/to/your/firebase-service-account-key.json"
PLAYER_USERNAME="YourValorantName" # Your exact in-game name for kill/death detection